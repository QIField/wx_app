# 复制本文件为 .env 后填入真实值（.env 不进 git）

# 环境：dev=测试库  prod=生产库（不填默认 dev，防止误连生产）
APP_ENV = dev

# 数据库连接（二选一按 APP_ENV 生效，必须带 utf8mb4 存微信表情）
DEV_DATABASE_URL = mysql+pymysql://root:密码@127.0.0.1:3306/wx_app_dev?charset=utf8mb4
PROD_DATABASE_URL = mysql+pymysql://root:密码@生产库地址:3306/wx_app?charset=utf8mb4

# 中间方。设备不再在配置里写死：登录后台后由开发者在「账号管理」里绑定到客服账号
MIDDLE_BASE_URL = http://中间方地址

# 登录令牌签名密钥（生产必须改成随机长串）；令牌默认有效期 72 小时
SECRET_KEY = change-me-to-a-long-random-string
TOKEN_EXPIRE_HOURS = 72

# 发送总开关：false=前端发送接口直接拒绝（防误发）；要联调发送时改 true 重启
SEND_ENABLED = false

# 上传文件公网基址：发图片/文件/视频要给中间方一个它服务器能下载到的 URL，
# 本机开发地址中间方拉不到；部署到公网后配 http(s)://域名（不配则用请求地址兜底）
PUBLIC_BASE_URL =
# 上传文件大小上限（字节，默认 50MB）
UPLOAD_MAX_BYTES = 52428800

# 收消息轮询间隔（秒）
POLL_INTERVAL_SECONDS = 2

# 发送结果确认轮询间隔（秒）
SEND_CONFIRM_INTERVAL = 1

# 资料兜底同步间隔（秒）：群名/好友昵称头像，默认 30 分钟一轮
PROFILE_INTERVAL_SECONDS = 1800

# 登录触发资料全量同步：true=已绑定设备的账号登录时对该设备做一次完整资料同步
PROFILE_LOGIN_SYNC_ENABLED = true
# 同一设备登录触发的冷却期（秒），默认 6 小时
PROFILE_LOGIN_COOLDOWN_SECONDS = 21600
