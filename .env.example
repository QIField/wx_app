# 复制本文件为 .env 后填入真实值（.env 不进 git）

# 环境：dev=测试库  prod=生产库（不填默认 dev，防止误连生产）
APP_ENV = dev

# 数据库连接（二选一按 APP_ENV 生效，必须带 utf8mb4 存微信表情）
DEV_DATABASE_URL = mysql+pymysql://root:密码@127.0.0.1:3306/wx_app_dev?charset=utf8mb4
PROD_DATABASE_URL = mysql+pymysql://root:密码@生产库地址:3306/wx_app?charset=utf8mb4

# 中间方
MIDDLE_BASE_URL = http://中间方地址
MIDDLE_OPENID = 设备openid

# 发送总开关：false=前端发送接口直接拒绝（防误发）；要联调发送时改 true 重启
SEND_ENABLED = false

# 收消息轮询间隔（秒）
POLL_INTERVAL_SECONDS = 2

# 发送结果确认轮询间隔（秒）
SEND_CONFIRM_INTERVAL = 1
